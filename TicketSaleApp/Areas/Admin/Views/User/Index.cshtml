
@{
    ViewData["Title"] = "Kullanıcı Listesi";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

@model IEnumerable<User>  

<h2>Kullanıcı Listesi</h2>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Tam İsim</th>
            <th>Email</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.UserId</td>
                <td>@user.FirstName @user.LastName</td>
                <td>@user.Email</td>
                <td>
                    <a href="@Url.Action("Edit", "User", new { area = "Admin", id = user.UserId })" class="btn btn-primary">Düzenle</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a href="@Url.Action("Create", "User")" class="btn btn-primary">Yeni Kullanıcı Oluştur</a>
