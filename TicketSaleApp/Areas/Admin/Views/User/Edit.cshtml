
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

@model User 

@{
    ViewData["Title"] = "Edit User";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Edit" method="post">
    <div class="form-group">
        <label asp-for="UserId" class="control-label"></label>
        <input asp-for="UserId" class="form-control" readonly />
    </div>
    <br />
    <div class="form-group">
        <label asp-for="FirstName" class="control-label"></label>
        <input asp-for="FirstName" class="form-control" />
    </div>
    <br />
    <div class="form-group">
        <label asp-for="LastName" class="control-label"></label>
        <input asp-for="LastName" class="form-control" />
    </div>
    <br />
    <div class="form-group">
        <label asp-for="Email" class="control-label"></label>
        <input asp-for="Email" class="form-control" />
    </div>
    <input asp-for="Status" class="form-control" value="true" hidden/>
    <input name="Password" type="hidden" value="@Model.Password" />
    <input name="CreatedAt" type="hidden" value="@Model.CreatedAt" />
    <br />
    <button type="submit" class="btn btn-primary">Güncelle</button>
    <a href="@Url.Action("Index", "User", new { area = "Admin" })" class="btn btn-secondary">İptal</a>
</form>
