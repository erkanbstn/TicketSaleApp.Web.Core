@model List<Ticket>

@{
    ViewData["Title"] = "Biletlerim";
    Layout = "~/Views/Shared/Layouts/_UserLayout.cshtml";
}

<div class="title">
    <i class="uil uil-ticket"></i>
    <span class="text">Biletlerim</span>
</div>

<div class="activity-data">
    <!-- Ticket ID Column -->
    <div class="data ticket-id">
        <span class="data-title">Bilet Numarası</span>
        @foreach (var ticket in Model)
        {
            <span class="data-list">@ticket.TicketId</span>
        }
    </div>

    <!-- Flight Information Column -->
    <div class="data flight-info">
        <span class="data-title">Uçuş Bilgisi</span>
        @foreach (var ticket in Model)
        {
            <span class="data-list">
                @ticket.Flight.FlightNumber - @ticket.Flight.DepartureCity -> @ticket.Flight.ArrivalCity
                <br />
                <small>@ticket.Flight.DepartureTime.ToString("g")</small>
            </span>
        }
    </div>

    <!-- Seat Number Column -->
    <div class="data seat-number">
        <span class="data-title">Koltuk Numarası</span>
        @foreach (var ticket in Model)
        {
            <span class="data-list">@ticket.Seat.SeatNumber</span>
        }
    </div>

    <!-- Ticket Status Column -->
    <div class="data ticket-status">
        <span class="data-title">Durum</span>
        @foreach (var ticket in Model)
        {
            <span class="data-list">
                @if (ticket.Status == TicketStatus.Beklemede)
                {
                    <span>Beklemede</span>
                }
                else if (ticket.Status == TicketStatus.Satıldı)
                {
                    <span>Satıldı</span>
                }
                else if (ticket.Status == TicketStatus.İptalEdildi)
                {
                    <span>İptal Edildi</span>
                }
            </span>
        }
    </div>

    <!-- Purchase Date Column -->
    <div class="data purchase-date">
        <span class="data-title">Satın Alma Tarihi</span>
        @foreach (var ticket in Model)
        {
            <span class="data-list">@ticket.PurchaseDate.ToString("g")</span>
        }
    </div>

    <!-- Cancel Button Column -->
    <div class="data cancel">
        <span class="data-title">İptal Et</span>
        @foreach (var ticket in Model)
        {
            <span class="data-list">
                @if (ticket.Status == TicketStatus.Beklemede)
                {
                    <form method="post" action="@Url.Action("CancelTicket", "User", new { ticketId = ticket.TicketId })" onsubmit="return confirm('Bu bileti iptal etmek istediğinizden emin misiniz?');">
                        <button type="submit" class="btn btn-danger">İptal Et</button>
                    </form>
                }
                else
                {
                    <span class="text-muted">İşlem Yapamazsınız</span>
                }
            </span>
        }
    </div>
</div>

<style>
    .activity-data {
        display: grid;
        grid-template-columns: repeat(6, 1fr); /* Kolonların sayısına göre düzenlenir */
        gap: 20px;
        margin-top: 20px;
    }

    .data {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .data-title {
        font-weight: bold;
        margin-bottom: 10px;
    }

    .data-list {
        margin-bottom: 10px;
        text-align: center;
    }

    .btn-danger {
        margin-top: 5px;
    }

    .text-muted {
        color: #6c757d;
        font-size: 0.9rem;
    }
</style>
